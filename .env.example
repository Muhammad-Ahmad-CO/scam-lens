# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored, so real keys never get committed.
# Keep keys in the Vercel dashboard (server-side env vars), never in chat or code.

# Which provider to use: "meta" or "baseten"
AI_PROVIDER=meta

# Plan A — Meta Model API
META_API_KEY=your-key-here

# Plan B — Baseten (open-weights Meta models)
BASETEN_API_KEY=your-key-here
BASETEN_MODEL=meta-models/muse-spark-open
